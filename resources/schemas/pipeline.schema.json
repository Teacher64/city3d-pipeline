{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "executor"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "executor": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "train",
              "infer",
              "evaluate",
              "annotate",
              "fuse",
              "export"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "object"
          },
          "params": {
            "type": "object"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    }
  }
}